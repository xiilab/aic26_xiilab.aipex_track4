# Runtime working directory (run_reproduce.sh recreates it on every run)
.work/
fullpipe/
*.log

# Smoke-run output (04/05 --smoke redirect here so a truncated artifact never lands in a cache)
ops/smoke/

# Personal local tool settings (recreated on permission approval) — not shared
.claude/

# ── Large artifacts — distributed as a Drive bundle (ARTIFACTS.md) ──────────
# The real files sit here locally, but git does not track any of them: `assets/` ships empty and is
# filled by the download. Individual files also exceed GitHub's 100 MB limit, so a commit that
# picked them up would fail to push.
#
# Weights, caches and data are blocked as whole trees below. Nothing under `assets/` is committed —
# see ARTIFACTS.md for what the bundle carries, what has to be fetched from its own source instead,
# and the licence each artifact comes under.

# Adapters and third-party bases
assets/model/**



# Reproduction-run output — regenerable by run_reproduce.sh
results/reproduced/**

__pycache__/
*.pyc
.DS_Store

# Training output (the RUNS_ROOT default — checkpoints and logs, tens of GB)
assets/runs/**

# Standard mount point for large data outside the repository — only the symlink is needed here,
# the real files are site-local. ARTIFACTS.md documents the layout it must expose.
assets/bundle
assets/external/**

# ── Reproduction-run (REP) output — all regenerable, 33 GB in total ───────────
# model_rep = the trained, selected and deployed weights (28 GB, filled by tools/promote.py)
# cache_rep = caches re-encoded from those weights (5 GB, encode_* / score_union_* --rep)
# They pair with the adopted assets/model and assets/cache for verification, so they stay out.
assets/model_rep/**
assets/cache_rep/**
.rep_logs/

# ── Datasets excluded entirely (distributed separately) ──────────────────────
# assets/data, 25 GB — raw (12 GB) · manifest · mining · benches · heldout_v1.
# The raw datasets are never redistributed; the derived trees come from the Drive bundle, or are
# rebuilt with train/gen/* and the build_* scripts. Environment variables that repoint them are in
# ARTIFACTS.md and in each script's docstring (PAB_TEST · PAB_TRAIN · MANIFEST_DIR …).
assets/data/**

# ── Caches excluded entirely (pipeline output · distributed separately) ───────
# assets/cache holds the adopted run's stage caches (including the S1 member caches build_base
# reads), assets/cache_rep the reproduction run's. Neither goes in the repository — download them,
# or rebuild with the per-stage scripts:
#   S1 pipeline/S1_base/encode/encode_*.py -> build_base.py -> build_union.py
#   S2 pipeline/S2_rerank/score_union_*.py · build_recs.py · dump_fuse_cache.py --from-union
#   S4 pipeline/S4_tail/dump_nntail_cache.py
assets/cache/**
assets/work
# git cannot carry empty directories, so `assets/` keeps one placeholder (assets/.gitkeep) and a
# clone gets the mount point itself. Everything under it stays ignored by the rules above.
# The subdirectories are created by setup_assets.sh (which setup_conda_envs.sh also calls);
# run_reproduce.sh creates its own output paths.
